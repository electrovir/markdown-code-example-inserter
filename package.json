{
    "name": "markdown-code-example-inserter",
    "version": "3.0.6",
    "description": "Syncs code examples with markdown documentation.",
    "keywords": [
        "automatic",
        "code",
        "examples",
        "insert",
        "inserter",
        "interpolator",
        "markdown",
        "readme",
        "snippet"
    ],
    "homepage": "https://github.com/electrovir/markdown-code-example-inserter",
    "bugs": {
        "url": "https://github.com/electrovir/markdown-code-example-inserter/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/markdown-code-example-inserter.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": {
        "md-code": "bin.js"
    },
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "npm run compile && virmator test node",
        "test:all": "npm test && runstorm --names spelling,format,docs,deps,lint \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^32.5.0",
        "@augment-vir/common": "^32.5.0",
        "@augment-vir/node": "^32.5.0",
        "glob": "^13.0.6",
        "rehype-parse": "^9.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "unified": "^11.0.5"
    },
    "devDependencies": {
        "@augment-vir/test": "^32.5.0",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/hast": "^3.0.5",
        "@types/mdast": "^4.0.4",
        "@types/node": "^26.6.3",
        "@types/unist": "^3.0.3",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "c8": "^12.0.0",
        "cspell": "^10.3.5",
        "dependency-cruiser": "^18.4.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^64.5.4",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.12.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unicorn": "^76.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.6",
        "npm-check-updates": "^23.1.0",
        "prettier": "3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^3.0.2",
        "runstorm": "^1.1.0",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.70.1",
        "virmator": "^14.37.1"
    },
    "peerDependencies": {
        "tsx": "*",
        "typescript": "^6"
    },
    "engines": {
        "node": ">=22"
    }
}
